# Copy to .env.local and fill in. Never commit real secrets.
# Production values live in Vercel (Project → Settings → Environment Variables).

# The club website (Payload CMS). Empty: the app runs as a preview with sample data.
# Local development: run the website on another port, e.g. `pnpm dev --port 3001` in its repo.
BACKEND_URL=

# API key of the app's service account (an admin user with "Enable API key" in the website
# admin). Required when BACKEND_URL is set; used to create the week's practices.
BACKEND_SERVICE_API_KEY=

# Development only: pin "now" to an ISO instant, e.g. a Monday morning before the season.
# Ignored in production.
APP_NOW=
