# Copy to .env.local and fill in. Never commit real secrets.
# Production values live in Vercel (Project → Settings → Environment Variables).

# The club website (Payload CMS). Empty: the app runs as a preview with sample data.
# Local development: run the website on another port, e.g. `pnpm dev --port 3001` in its repo.
BACKEND_URL=

# API key of the app's service account (an admin user with "Enable API key" in the website
# admin). Required when BACKEND_URL is set; used to create the week's practices.
BACKEND_SERVICE_API_KEY=

# Development only: pin "now" to an ISO instant, e.g. a Monday morning before the season.
# Ignored in production.
APP_NOW=

# Web Push (ADR-0003). Empty: notifications are unavailable. Generate a key pair with
# `pnpm exec web-push generate-vapid-keys`; set all three or none. Never reuse the local pair
# in production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://erlangen-cricket-club.vercel.app

# Scheduled jobs (ADR-0004): the secret GitHub Actions signs its hourly ticks with, at least 32
# characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# The same value goes into the repository's JOBS_SECRET secret. Empty: the tick endpoint is off.
JOBS_SECRET=
